# Copy to server/.env and source locally. Never commit populated secrets.
ARRIVAL_API_TOKEN=replace-with-a-long-random-test-token
ARRIVAL_DB=server/outbox.sqlite3
SMS_MODE=mock
SMS_RECIPIENTS_JSON='{"demo":{"phone":"01000000000","consented":true}}'
# SENS mode only; use a registered sender and a consenting test recipient.
SENS_SERVICE_ID=
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_SENDER_PHONE=
ALLOW_TEST_INPUT_SMS=false
